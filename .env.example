# Copy to .env and fill in what you have.
# --- Multi-device sync & login (needed when the robot is hosted online) ---
APP_PASSWORD=              # any password; each device signs in once
DATABASE_URL=              # Supabase Postgres URL; leave empty to use a local SQLite file
# --- Keys: only ANTHROPIC_API_KEY is needed for the chat;
# Deriv and Binance prices need no key at all.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
TWELVEDATA_API_KEY=        # free: https://twelvedata.com/register  (8/min, 800/day)
FRED_API_KEY=              # free: https://fred.stlouisfed.org/docs/api/api_key.html
FINNHUB_API_KEY=           # free: https://finnhub.io/register  (extra news)
ALPHAVANTAGE_API_KEY=      # free: https://www.alphavantage.co/support/#api-key  (scored news, 25/day)
DERIV_APP_ID=1089          # register your own at https://developers.deriv.com for production

DISPLAY_TZ=Africa/Johannesburg
WATCHLIST=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURJPY,GBPJPY,XAUUSD,BTCUSD,ETHUSD,USDZAR,R_75,R_100,BOOM1000,CRASH1000
SCAN_TIMEFRAMES=M15,H1,H4
AUTO_SCAN=1
AUTO_PAPER_TRADE=1
MIN_PROBABILITY=0.45
MIN_EXPECTANCY_R=0.10
REWARD_R=2.0
SL_ATR_MULT=1.5
MAX_HOLD_BARS=30
NEWS_BLACKOUT_MIN=30
